[Unit]
Description=MyHiFi Player High-Fidelity Audio Turntable
After=network.target sound.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/hide_player_flutter
Environment=DISPLAY=:0
Environment=PI_KIOSK=1
ExecStart=/home/pi/hide_player_flutter/build/linux/arm64/release/bundle/hide_player_flutter
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target

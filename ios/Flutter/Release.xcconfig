#include "Generated.xcconfig"

LIBRARY_SEARCH_PATHS = $(inherited) $(PROJECT_DIR)/lib/$(PLATFORM_NAME)
OTHER_LDFLAGS = $(inherited) -force_load $(PROJECT_DIR)/lib/$(PLATFORM_NAME)/libhifi_audio_ffi.a -Wl,-exported_symbols_list,$(PROJECT_DIR)/exported_symbols.txt -framework AVFoundation -framework AudioToolbox -framework CoreAudio -lsqlite3
